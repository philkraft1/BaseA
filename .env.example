# Client — .env.local and Vercel. Address comes from `npm run contracts:deploy`.
NEXT_PUBLIC_STANDING_ORDER_ADDRESS=0x
NEXT_PUBLIC_USDC_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
NEXT_PUBLIC_RPC_URL=https://mainnet.base.org
# base.dev → project → Settings → Builder Codes
NEXT_PUBLIC_BUILDER_CODE=
NEXT_PUBLIC_APP_URL=https://basea-tau.vercel.app

# Server only — never expose these to the client (Vercel + .env.local)
# portal.cdp.coinbase.com → API keys
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
# portal.cdp.coinbase.com → Wallets / API Wallets → Wallet Secret (not the API key)
CDP_WALLET_SECRET=
PAYMASTER_URL=
CRON_SECRET=
BASE_NOTIFICATIONS_API_KEY=
BASE_APP_URL=https://basea-tau.vercel.app

# Deploy / verify — contracts/.env only, never commit
# Export from MetaMask/Rabby/Coinbase Wallet; fund with ETH on Base
# DEPLOYER_PRIVATE_KEY=
# GET /api/subscription/owner → address (after CDP is configured)
# OPERATOR_ADDRESS=
# etherscan.io/apidashboard (API V2; works for Basescan)
# ETHERSCAN_API_KEY=
